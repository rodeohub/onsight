{
  "name": "@slacklineinternational/onsight",
  "version": "0.18.0",
  "description": "Onsight, the official design system of the International Slackline Association (ISA): tokens, docs and components for people and AI agents.",
  "keywords": [
    "design-system",
    "design-tokens",
    "slackline",
    "isa",
    "tailwind",
    "react",
    "accessibility"
  ],
  "homepage": "https://rodeohub.github.io/onsight/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rodeohub/onsight.git"
  },
  "bugs": {
    "url": "https://github.com/rodeohub/onsight/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "docs",
    "tokens",
    "components",
    "behavior",
    "react",
    "scripts",
    "examples",
    "AGENTS.md",
    "DECISIONS.md",
    "CHANGELOG.md",
    "LICENSE",
    "assets"
  ],
  "exports": {
    "./tokens.css": "./dist/tokens.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./fonts.css": "./dist/fonts.css",
    "./tokens.json": "./dist/tokens.json",
    "./components.css": "./dist/components.css",
    "./react": {
      "types": "./react/index.d.ts",
      "default": "./react/index.js"
    },
    "./isa.js": "./dist/isa.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs && node scripts/check-contrast.mjs && node scripts/audit.mjs components --strict",
    "audit": "node scripts/audit.mjs",
    "test:react": "node scripts/test-react.mjs",
    "test:tailwind": "node scripts/test-tailwind.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "onsight-audit": "scripts/audit.mjs",
    "isa-audit": "scripts/audit.mjs",
      "onsight-init": "scripts/init.mjs"
  },
  "license": "SEE LICENSE IN LICENSE",
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
